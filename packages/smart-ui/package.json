{
  "name": "@smart/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens": "./src/tokens/index.css",
    "./tokens/*": "./src/tokens/*.css",
    "./components": "./src/components/index.js",
    "./components/*": "./src/components/*/index.js",
    "./layouts": "./src/layouts/index.js",
    "./layouts/*": "./src/layouts/*/index.js",
    "./workspaces": "./src/workspaces/index.js",
    "./workspaces/engine": "./src/workspaces/engine.js",
    "./workspaces/*": "./src/workspaces/*/index.js"
  },
  "scripts": {
    "dev": "echo '@smart/ui: No dev server needed'",
    "build": "echo '@smart/ui: No build step required — consumers import ESM directly'",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "description": "SMART UI — Design tokens, components, layouts, and workspace engine for SMART Platform",
  "author": "PT SMART VISION INDOTAMA"
}
