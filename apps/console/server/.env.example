# SMART Console Server Environment (SP-027 M2 + M3)
# Copy ke .env lalu isi nilainya. JANGAN commit .env (sudah di-gitignore).

# Port backend Platform, terpisah dari Inventory (3001)
PORT=3002

# MongoDB (satu database dengan Inventory)
MONGO_URI=mongodb://127.0.0.1:27017/smart_inventory

# ── SP-027 M3 — Security Foundation ──
# WAJIB di-set di produksi. JWT_SECRET & JWT_REFRESH_SECRET harus SAMA dengan
# apps/inventory/server/.env agar token impersonasi Console dapat diverifikasi
# oleh server Inventory.
JWT_SECRET=generate-dengan-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-dengan-openssl-rand-hex-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUND=10
COOKIE_SECRET=generate-dengan-openssl-rand-hex-32

# Refresh token httpOnly cookie
COOKIE_NAME=smart_refresh
# Secure flag — true di production (https), false untuk dev http
COOKIE_SECURE=true

# Rate limiting
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600

# Seed SuperAdmin — jika kosong, password random dibuat saat seed pertama
SEED_SUPERADMIN_PASSWORD=

# CORS — comma-separated origin (kosongkan untuk daftar default dev)
CORS_ORIGINS=

# ── SP-027 M4 — Monitoring Center ──
# (semua punya default aman — opsional untuk override)
MONITORING_CHECK_TIMEOUT_MS=3000
MONITORING_RESPONSE_WARN_MS=500
MONITORING_RESPONSE_DEGRADED_MS=1500
MONITORING_CPU_WARN_PCT=100
MONITORING_CPU_DEGRADED_PCT=200
MONITORING_MEMORY_WARN_PCT=80
MONITORING_MEMORY_DEGRADED_PCT=90
MONITORING_DISK_WARN_PCT=80
MONITORING_DISK_DEGRADED_PCT=90
MONITORING_RETENTION_DAYS=7
MONITORING_CACHE_TTL_MS=4000
MONITORING_DISK_PATHS=/,/srv
# Override/perluas Application Registry tanpa ubah kode (JSON array):
# MONITORING_APPS_JSON=[{"id":"wms","name":"SmartWMS","healthEndpoint":"http://127.0.0.1:4001/api/health"}]
